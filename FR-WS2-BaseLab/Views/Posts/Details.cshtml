@model FR_WS2_BaseLab.Models.Post

@{
    ViewData["Title"] = "Details";
}

<h1>Détails</h1>

<div>
    <h4>Post</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Inactive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Inactive)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Texte)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Texte)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Date)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Date)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Top)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TopId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.User)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UserId)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" asp-route-topicId="@(ViewData["TopicId"])">Edit</a> |
    <div>
        @if (ViewData["TopicId"] != null)
        {
             @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin")) 
            {
                 <a asp-action="Index" asp-route-id="@ViewData["TopicId"]">Back to List</a>
            }
            else{
                <a asp-action="AfficherMessages" asp-route-id="@ViewData["TopicId"]">Back to List</a>
            }
        }
        else
        {
            <a asp-controller="Home"asp-action="Index">Back to Home</a>
        } 
    </div>
</div>