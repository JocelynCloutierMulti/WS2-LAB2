@model FR_WS2_BaseLab.Models.Post

@{
    ViewData["Title"] = "Details";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 m-0"><i class="bi bi-info-circle"></i> Post details</h1>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title">Post</h4>
        <hr />
        <dl class="row mb-0">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Inactive)
            </dt>
            <dd class="col-sm-10">
                @if (Model.Inactive)
                {
                    <span class="badge bg-warning text-dark">Inactive</span>
                }
                else
                {
                    <span class="badge bg-success">Active</span>
                }
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Texte)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Texte)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Date)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Date)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Top)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Top.Id)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.User)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.User.Id)
            </dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2 flex-wrap mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-pencil"></i> Edit
    </a>
    <a asp-action="Index" asp-route-id="@Model.TopId" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>
