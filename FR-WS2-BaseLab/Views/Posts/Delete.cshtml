@model FR_WS2_BaseLab.Models.Post

@{
    ViewData["Title"] = "Delete";
    if (User?.Identity?.IsAuthenticated == false) return;
}

<h1>Supprimer un message</h1>

<h3>Êtes-vous certain de vouloir supprimer ce message ?</h3>
<div>
    <h4>Message</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Inactive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Inactive)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Texte)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Texte)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Date)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Date)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Top)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TopId)
        </dd>
        
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.User)
        </dt>
        
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UserId)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" name="topicId" value="@ViewData["TopicId"]" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <div>
            @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("ADMINISTRATOR")) 
            {
                <a asp-action="Index" asp-route-id="@ViewData["TopicId"]">Back to List</a>
            }
            else{
                <a asp-action="AfficherMessages" asp-route-id="@ViewData["TopicId"]">Back to List</a>
            }
        </div>
    </form>
</div>