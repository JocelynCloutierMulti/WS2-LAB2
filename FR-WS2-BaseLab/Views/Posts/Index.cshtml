@using System.Security.Claims
@model IEnumerable<FR_WS2_BaseLab.Models.Post>

@{
    ViewData["Title"] = "Posts";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">Posts</h1>

    @if (User.Identity.IsAuthenticated)
    {
        <a asp-action="Create" asp-route-id="@ViewData["TopicId"]" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nouveau post
        </a>
    }
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Statut</th>
            <th>Texte</th>
            <th>Date</th>
            <th>Topic</th>
            <th>Auteur</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Inactive)
                    {
                        <span class="badge bg-danger">Inactif</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Actif</span>
                    }
            </td>

            <td>
                @(item.Texte?.Length > 60
                                ? item.Texte.Substring(0, 60) + "..."
                                : item.Texte)
            </td>

                <td>@item.Date.ToString("yyyy-MM-dd HH:mm")</td>

                <td>@item.Top?.Title</td>

                <td>@item.User?.UserName</td>

                <td class="text-end">

                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-sm btn-secondary">
                        Détails
                    </a>

                @if (User.IsInRole("ADMINISTRATOR") || item.UserId == userId)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-warning ms-1">
                            Modifier
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger ms-1">
                            Supprimer
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
