@model IEnumerable<FR_WS2_BaseLab.Models.Post>

@{
    ViewData["Title"] = "Index";
    if(!User.IsInRole("ADMINISTRATOR")) return;
}

<h1>Messages</h1>

<p class="creer-p">
    <a asp-action="Create" asp-route-id="@(ViewData["TopicId"])" class="creer-a">Créer un message</a>
</p>
<div class="backList">
    <a asp-action="Index" asp-route-id="@ViewData["CategoryId"]" class="backList-a" asp-controller="Topics">Back to List</a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Inactive)
            </th>
            <th class="th-long">
                @Html.DisplayNameFor(model => model.Texte)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Top)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Inactive)
            </td>
            <td class="td-long">
                @Html.DisplayFor(modelItem => item.Texte)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TopId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserId)
            </td>
            <td>
                <div class="boutonsTable">
                    <a class="details-a" 
                        asp-action="Details"
                        asp-route-id="@item.Id"
                        asp-route-topicId="@(ViewData["TopicId"])">Details</a>
                    <a class="edit-a"  asp-action="Edit" 
                        asp-route-id="@item.Id"
                        asp-route-topicId="@(ViewData["TopicId"])">Edit</a>
                    <a class="delete-a"  asp-action="Delete" 
                        asp-route-id="@item.Id" 
                        asp-route-topicId="@(ViewData["TopicId"])">Delete</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
