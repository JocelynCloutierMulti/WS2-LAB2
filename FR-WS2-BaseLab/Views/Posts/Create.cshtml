@model FR_WS2_BaseLab.Models.Post

@{
    ViewData["Title"] = "Create";
    if (User?.Identity?.IsAuthenticated == false) return;
}
<h1>Publier un message</h1>
<hr />
<div class="row">
    <div class="col-lg-4 colonne">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TopId"/>
            <div class="form-group">
                <label asp-for="Texte" class="control-label"></label>
                <textarea asp-for="Texte" class="form-control"></textarea>
                <span asp-validation-for="Texte" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Publier" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("ADMINISTRATOR")) 
    {
        <a asp-action="Index" asp-route-id="@Model?.Id" asp-route-topicId="@(ViewData["TopicId"])">Back to List</a>
    }
    else{
        <a asp-action="AfficherMessages" asp-route-id="@(ViewData["TopicId"])">Back to List</a>
    }
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
