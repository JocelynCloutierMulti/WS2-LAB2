@model FR_WS2_BaseLab.Models.Topic

@{
    ViewData["Title"] = "Delete";
    var cat = Model.CatId;
}

<h1>Delete</h1>

<h3>Êtes-vous certain de vouloir supprimer ce sujet ?</h3>
<div>
    <h4>Sujets</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Inactive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Inactive)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Texte)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Texte)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Date)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Date)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Views)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Views)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Cat)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CatId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.User)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UserId)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin")) 
        {
            <a asp-action="Index" asp-route-id="@Model.CatId">Back to List</a>
        }
        else{
            <a asp-action="AfficherSujets" asp-route-id="@Model?.CatId">Back to List</a>
        }
    </form>
    <div asp-validation-summary="ModelOnly" class="text-danger"> @TempData["ErrorMessage"]</div>
</div>
