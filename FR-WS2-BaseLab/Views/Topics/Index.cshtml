@model IEnumerable<FR_WS2_BaseLab.Models.Topic>

@{
    ViewData["Title"] = "Index";
    if(!User.IsInRole("Admin")) return;
}
<h1>Sujets</h1>
@if (ViewData["CategoryId"] != null)
{
    <p class="creer-p">
        <a asp-action="Create"asp-route-id="@ViewData["CategoryId"]"class="creer-a">Créer un sujet</a>
    </p>
}

<div class="backList">
    <a asp-controller="Categories" asp-action="Index">Back to Categories</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Inactive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th class="th-long">
                @Html.DisplayNameFor(model => model.Texte)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Views)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                Posts
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Inactive)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td class="td-long">
                    @Html.DisplayFor(modelItem => item.Texte)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Views)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cat!.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.User!.UserName)
                </td>
                <td>
                @if (!item.Posts.Any())
                {
                    <p class="text-muted">Aucun message</p>
                }
                else
                {
                    @foreach (var p in item.Posts.Take(3))
                    {
                        if(p == null){<p>"Aucun message"</p>}

                        <div class="msgTableSujet">
                            <p><b>@p?.Texte</b></p>
                            <p><i><small>Publié le @p?.Date.ToShortDateString()</small></i></p>
                            <p><i><small>Par @p?.User?.UserName</small></i></p>
                        </div>
                    }
                }
                </td>
                <td>
                    <div class="boutonsTable">
                    <a class="details-a" 
                        asp-action="Details"
                        asp-route-id="@item.Id">Details</a>
                    <a class="edit-a"  asp-action="Edit" 
                        asp-route-id="@item.Id">Edit</a>
                    <a class="delete-a"  asp-action="Delete" 
                        asp-route-id="@item.Id">Delete</a>
                     <a class="boutonsTable-vert" 
                       asp-controller="Posts" 
                       asp-action="index" 
                       asp-route-id="@item.Id">Messages
                    </a>
                </div>
                </td>
            </tr>
        }
    </tbody>
</table>
