@model IEnumerable<FR_WS2_BaseLab.Models.Topic>



@{
    ViewData["Title"] = "Sujets";
}



<h1>Sujets</h1>



<p>
    <a asp-action="Create" asp-route-id="@ViewData["CategoryId"]" class="btn btn-success">
        Créer un sujet
    </a>
</p>



<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Inactive)</th>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.Texte)</th>
            <th>@Html.DisplayNameFor(model => model.Date)</th>
            <th>@Html.DisplayNameFor(model => model.Views)</th>
            <th>Auteur</th>
            <th>Aperçu des messages</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            int cnt = 0;    
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Inactive)</td>
                                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                                <td>@Html.DisplayFor(modelItem => item.Texte)</td>
                                <td>@Html.DisplayFor(modelItem => item.Date)</td>
                                <td>@Html.DisplayFor(modelItem => item.Views)</td>
                                <td>@(item.User?.UserName ?? "Inconnu")</td>
                                <td>
                    @if (item.Posts != null && item.Posts.Any())
                    {
                        @foreach (var p in item.Posts)
                        {
                            if (cnt > 2) { break; }
                            <div class="card text-center text-black mt-1">
                                <div>@p.Date.ToShortDateString()</div>
                                <div>@(p.User?.UserName ?? "Inconnu") : @p.Texte</div>
                            </div>
                            cnt++;
                        }
                    }
                    else
                    {
                        <em>Aucun message</em>
                    }
                    <div class="mt-2">
                        <a asp-controller="Posts" asp-action="Index" asp-route-id="@item.Id"
                                                     class="btn btn-primary btn-sm">
                            Voir la discussion
                        </a>
                    </div>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>



<div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Retour à l'accueil</a>
</div>