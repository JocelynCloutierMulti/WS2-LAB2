@model IEnumerable<FR_WS2_BaseLab.Models.Topic>

@{
    ViewData["Title"] = "Index";
    int cnt = 0;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 m-0">Topics</h1>
    <a asp-action="Create" asp-route-id="@ViewData["CategoryId"]" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Create New
    </a>
</div>

<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Inactive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Texte)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Views)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                Posts
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Inactive)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Texte)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Views)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cat.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.User.UserName)
                </td>
                <td>
                    @foreach (var p in item.Posts)
                    {
                        if (cnt > 2)
                            break;
                        <div class="card text-center mt-1 shadow-sm">
                            <div class="card-body p-2">
                                <div>@p.Date.ToShortDateString()</div>
                                <div>@p.User.UserName: @p.Texte</div>
                            </div>
                        </div>

                        cnt++;
                    }

                    <div class="mt-2">
                        <a asp-controller="Posts" asp-action="Index" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                            Voir la Discussion!
                        </a>
                    </div>
                </td>
                <td>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller ="Home" asp-action="Index" class="btn btn-sm btn-outline-primary">
                            Back to home
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
