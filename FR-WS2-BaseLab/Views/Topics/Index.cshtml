@model IEnumerable<FR_WS2_BaseLab.Models.Topic>

@{
    ViewData["Title"] = "Index";
    int cnt = 0;
}

<h1>Index</h1>

<p>
    <a asp-action="Create" asp-route-id="@ViewData["CategoryId"]">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Inactive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Texte)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Views)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                Posts
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Inactive)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Texte)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Views)
                </td>
                <td>
                    @(item.Cat?.Name ?? "")
                </td>
                <td>
                    @(item.User?.UserName ?? "")
                </td>
                <td>
                    @foreach (var p in item.Posts)
                    {
                        if (cnt > 2)
                            break;
                        <div class="card text-center text-black mt-1">
                            <div>@p.Date.ToShortDateString()</div>
                            <div>@(p.User?.UserName ?? ""): @p.Texte</div>
                        </div>

                        cnt++;
                    }

                    <div><a asp-controller="Posts" asp-action="Index" asp-route-id="@item.Id" class="btn btn-primary">Voir la Discussion!</a></div>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
