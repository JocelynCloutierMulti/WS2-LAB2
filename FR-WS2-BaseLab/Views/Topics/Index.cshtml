@using System.Security.Claims
@model IEnumerable<FR_WS2_BaseLab.Models.Topic>

@{
    ViewData["Title"] = "Sujets";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">Sujets</h1>

    @if (User.Identity.IsAuthenticated)
    {
        <a asp-action="Create" asp-route-id="@ViewData["CategoryId"]" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nouveau sujet
        </a>
    }
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Statut</th>
            <th>Titre</th>
            <th>Texte</th>
            <th>Date</th>
            <th>Vues</th>
            <th>Catégorie</th>
            <th>Auteur</th>
            <th>Dernier Post</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Inactive)
                    {
                        <span class="badge bg-danger">Inactif</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Actif</span>
                    }
            </td>
            <td>@item.Title</td>

            <td>
                @(item.Texte?.Length > 60
                                ? item.Texte.Substring(0, 60) + "..."
                                : item.Texte)
            </td>
                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                <td>@item.Views</td>
                <td>@item.Cat?.Name</td>
                <td>@item.User?.UserName</td>
                <td style="max-width: 250px;">
                @if (item.Posts.Any())
                    {
                        var lastPost = item.Posts
                        .OrderByDescending(p => p.Date)
                        .First();

                        <div class="card p-2 mb-2 shadow-sm">
                            <div class="small text-muted">@lastPost.Date.ToShortDateString()</div>
                            <div><strong>@lastPost?.User?.UserName</strong> : @lastPost.Texte</div>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">Aucun post</span>
                    }

                    <a asp-controller="Posts" asp-action="Index" asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary w-100 mt-2">
                        Voir la discussion →
                    </a>
                </td>

                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">
                        Détails
                    </a>
                   
                    @if (User.IsInRole("ADMINISTRATOR") || item.UserId == userId)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning ms-1">
                            Modifier
                        </a>
                    }

                    @if (User.IsInRole("ADMINISTRATOR"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger ms-1">
                            Supprimer
                        </a>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>

