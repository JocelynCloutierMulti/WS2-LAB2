@using System.Text.Json
@model IEnumerable<FR_WS2_BaseLab.Models.Topic>
@{
    ViewData["Title"] = "Index";
    if(!User.IsInRole("Admin")) return;
}

<h1>Sujets</h1>
    
@if (ViewData["CategoryId"] != null){
    <p class="creer-p"><a asp-action="Create"asp-route-id="@ViewData["CategoryId"]"class="creer-a">Créer un sujet</a></p>}
        
<div class="backList"><a asp-controller="Categories" asp-action="Index">Back to Categories</a></div>
<table class="table">
    <thead>
        <tr>
            <th>Statut</th>
            <th>Titre</th>
            <th class="th-long">Description</th>
            <th>Date création</th>
            <th>Vues</th>
            <th>Catégorie</th>
            <th>Utilisateur</th>
            <th>Messages récents</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@if(item.Inactive){<p style="color:red;font-weigth:bold;">Inactif</p>}else{<p>Actif</p>}</td>
                <td>@item.Title</td>
                <td class="td-long">@item.Texte</td>
                <td>@item.Date.ToString()</td>
                <td>@item.Views</td>
                <td>@item.Cat!.Name</td>
                <td>@item.User!.UserName</td>
                <td>
                    @if (!item.Posts.Any()){<p class="text-muted">Aucun message</p>}
                    else
                    {
                       var premier = item.Posts.OrderByDescending(p => p.Date).First();
                        <div class="msgCarousel">
                            <div class="msgContent msgTableSujet" id="msg-content-@item.Id">
                                <div class="msgCarouselTitle">
                                    <span class="arrow" onclick="changeMsg(@item.Id, -1)">◀</span>
                                    <h4><b>Message #@premier.Id</b></h4>
                                    <span class="arrow" onclick="changeMsg(@item.Id, 1)">▶</span>  
                                </div>
                                <p class="msgText"><b>@premier.Texte</b></p>
                                <p><small><b>Publié le </b>@premier.Date.ToShortDateString()</small></p>
                                <p><small><b>Par </b>@premier.User?.UserName</small></p>
                            </div>
                            <script>
                                window.msgData = @Html.Raw(JsonSerializer.Serialize(ViewData["Messages"] ?? new { }));
                            </script>
                        </div>
                    }
                </td>
                <td>
                    <div class="boutonsTable">
                    <a class="details-a" 
                        asp-action="Details"
                        asp-route-id="@item.Id">Details</a>
                    <a class="edit-a"  asp-action="Edit" 
                        asp-route-id="@item.Id">Edit</a>
                    <a class="delete-a"  asp-action="Delete" 
                        asp-route-id="@item.Id">Delete</a>
                     <a class="boutonsTable-vert" 
                       asp-controller="Posts" 
                       asp-action="index" 
                       asp-route-id="@item.Id">Messages
                    </a>
                </div>
                </td>
            </tr>
        }
    </tbody>
</table>