@model FR_WS2_BaseLab.Models.Topic

@{
    ViewData["Title"] = "Create";
}

<h1>Créer un sujet</h1>
<hr />
<div class="row">
    <div class="col-lg-4 colonne">
        <form asp-action="Create">
            <span asp-validation-for="UserId" class="text-danger"></span>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("ADMINISTRATOR"))
            { 
                <div class="form-group">
                    <label asp-for="CatId"></label>
                    <select asp-for="CatId"
                            asp-items="ViewBag.Categories"
                            class="form-control">
                        <option value="">-- Choisir une catégorie --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="UserId"></label>
                    <select asp-for="UserId"
                            asp-items="ViewBag.Users"
                            class="form-control">
                        <option value="">-- Choisir un utilisateur --</option>
                    </select>
                </div>
            } 
            else{
                 <input type="hidden" asp-for="CatId" />
            }
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Texte" class="control-label"></label>
                <input asp-for="Texte" class="form-control" />
                <span asp-validation-for="Texte" class="text-danger"></span>
            </div>
             <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("ADMINISTRATOR")) 
    {
        <a asp-action="Index" asp-route-id="@ViewData["CategoryId"]">Back to List</a>
    }
    else{
        <a asp-action="Index" asp-controller="Home">Back to List</a>
    }
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

