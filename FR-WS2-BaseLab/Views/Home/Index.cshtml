@model IEnumerable<FR_WS2_BaseLab.Models.Category>
@{
    ViewData["Title"] = "Home Page";
}
<div class="row justify-content-around">
    @foreach (var item in Model)
    {
        <div class="card" style="width: 25rem;">
            <div class="card-body">
                <div id="homeCategory">
                    <h5 class="card-title">@item.Name</h5>
                    @if (item.CategoryImages != null && item.CategoryImages.Any(i => i.AfficherImage)){
                        var image = item.CategoryImages.FirstOrDefault(i => i.AfficherImage);
                        if (image != null){
                            <img src="~/images/img_categories/@image.FileName" id="homeCategoryImage" alt="@image.AltText"/>}} 
                    <p class="card-text">@item.Description</p>
                    <ul> 
                        <div class="homeSujetsCat">
                            <h6>Nombre de sujets : @item.Topics.Count</h6>
                            @foreach(var t in item.Topics)
                            {
                                <li>
                                    <a asp-controller="Topics" asp-action="Details" asp-route-id="@t.Id">@t.Title</a>
                                </li>
                            }
                        </div>
                    </ul>
                </div>
                 @if(item.Topics.Any()){
                    <div class="blocBtnHome">
                        <a asp-controller="Topics" asp-action="AfficherSujets" 
                            asp-route-id="@item.Id" class="btn btn-success">Voir les sujets &rarr;</a>
                    </div>
                }
                else{
                    <h6 id="h6-homeCreateSujet">Soyez le premier à créer un sujet !</h6>
                    <div class="blocBtnHome">
                        <a class="btn btn-primary" 
                            asp-action="Create" 
                            asp-controller="Topics"
                            asp-route-id="@item.Id">Créer un sujet &rarr;</a>
                    </div>
                }
            </div>
        </div>
    }
</div>

