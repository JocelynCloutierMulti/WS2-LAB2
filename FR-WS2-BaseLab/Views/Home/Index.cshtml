@model IEnumerable<FR_WS2_BaseLab.Models.Category>
@{
    ViewData["Title"] = "Home Page";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">Catégories</h1>
    @if (User.IsInRole("ADMINISTRATOR"))
    {
        <a class="btn btn-success" asp-controller="Categories" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Créer une catégorie
        </a>
    }
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card shadow-sm h-100 d-flex flex-column">

                @if (!string.IsNullOrEmpty(item.Image))
                {
                    <img src="@item.Image" class="card-img-top"
                         style="height: 180px; object-fit: cover;" alt="Image catégorie" />
                }
                else
                {
                    <div class="bg-light d-flex justify-content-center align-items-center"
                         style="height: 180px;">
                        <span class="text-muted">Aucune image</span>
                    </div>
                }

            <div class="card-body d-flex flex-column">
                <h5 class="card-title fw-bold">@item.Name</h5>

                <h6 class="card-subtitle mb-2 text-muted">
                    @item.Topics.Count sujet(s)
                </h6>

                <p class="card-text">
                    @(item.Description?.Length > 80
                                        ? item.Description.Substring(0, 80) + "..."
                                        : item.Description)
                </p>

                    <div class="mt-auto">
                    @if (item.Topics.Any())
                        {
                            <div class="mb-3">
                                <strong>Sujets récents :</strong>
                                <ul class="list-unstyled mt-2">
                                    @foreach (var t in item.Topics.Take(3))
                                    {
                                        <li>
                                            <a asp-controller="Topics" asp-action="Details" asp-route-id="@t.Id">
                                                • @t.Title
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Aucun sujet pour le moment.</p>
                        }

                        <a asp-controller="Topics" asp-action="Index" asp-route-id="@item.Id"
                           class="btn btn-outline-primary w-100">
                            Voir tous les sujets →
                        </a>
                    </div>
                </div>

            </div>
        </div>

    }
</div>
