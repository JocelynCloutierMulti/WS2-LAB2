@model FR_WS2_BaseLab.Models.Category

@{
    ViewData["Title"] = "Delete";
    if(!User.IsInRole("Admin")) return;
    var imageActive = Model.CategoryImages?.FirstOrDefault(i => i.AfficherImage);
}

<h1>Supprimer une catégorie</h1>

<h3>Êtes-vous certain de vouloir supprimer cette catégorie ?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Inactive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Inactive)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
         @if (imageActive != null)
        {
            <img src="~/images/img_categories/@imageActive.FileName"
                style="max-width:200px; max-height:200px;" alt="@imageActive.AltText"/>
        }
        </dt>
        <dd class = "col-sm-10">
        </dd>
    </dl>
    <form asp-action="Delete">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Supprimer" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>