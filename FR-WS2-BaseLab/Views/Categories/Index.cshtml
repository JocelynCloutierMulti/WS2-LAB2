@model IEnumerable<FR_WS2_BaseLab.Models.Category>

@{
    ViewData["Title"] = "Index";
    if(!User.IsInRole("Admin")) return;
}

<h1>Catégories</h1>
<p class="creer-p"><a asp-action="CreateCategorie" class="creer-a">Créer une catégorie</a></p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Inactive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th class="th-long">
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                Image
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr id="tr-Cat">
            <td>
                @if(item.Inactive){<p style="color:red;font-weigth:bold;">Inactive</p>}
                else{<p>Active</p>}
            </td>
            <td>
                <b>@Html.DisplayFor(modelItem => item.Name)</b>
            </td>
            <td class="td-long">
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            @if (item.CategoryImages != null && item.CategoryImages.Any(i => i.AfficherImage)){
                var image = item.CategoryImages.FirstOrDefault(i => i.AfficherImage);
                if (image != null){
                    <td>
                        <img src="~/images/img_categories/@image.FileName" style="max-width:100px; max-height:100px;" />
                    </td>}
            }else{<td>Aucune image</td>}            
            <td>
                <div class="boutonsTable">
                    <a class="details-a" asp-action="Details" asp-route-id="@item.Id">Details</a>
                    <a class="edit-a" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="delete-a" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    <a class="boutonsTable-vert" asp-controller="Topics" asp-action="Index" asp-route-id="@item.Id">Sujets</a>
                </div>
            </td>
        </tr>
    }</tbody>
</table>
