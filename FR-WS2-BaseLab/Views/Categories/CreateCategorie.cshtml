@model FR_WS2_BaseLab.Models.Category

@{
    ViewData["Title"] = "CreateCategorie";
    if(!User.IsInRole("Admin")) return;
}

<h1>Créer une catégorie</h1>
<hr />
<div class="row">
    <div class="col-lg-4 colonne">
        <form id="createCategoryForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
             <div class="form-group">
                <img id="imagePreview" class="img-thumbnail mb-2" style="max-width:200px; max-height:200px;" />
            </div>
            <div class="form-group">
                <label>Ajouter une image</label>
                <input type="file" id="imageFileInput" class="form-control"; accept="image/*" />
            </div>
            <div class="form-group">
                <input type="submit" id="btnCreate" value="Créer" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
