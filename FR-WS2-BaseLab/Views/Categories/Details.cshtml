@model FR_WS2_BaseLab.Models.Category

@Html.AntiForgeryToken()

<section class="mt-4" id="category-images-section"
         data-category-id="@Model.Id">
    <h2>Images de la catégorie</h2>

    <form id="image-upload-form" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="image-file" class="form-label">Image</label>
            <input id="image-file" name="file" type="file"
                   class="form-control"
                   accept="image/png,image/jpeg,image/webp" required>
        </div>

        <div class="mb-3">
            <label for="image-alt" class="form-label">Texte alternatif</label>
            <input id="image-alt" name="altText" type="text"
                   class="form-control"
                   maxlength="255">
        </div>

        <button type="submit" class="btn btn-primary">Téléverser</button>
    </form>
    <img id="image-preview" hidden
         style="max-height: 150px; margin-top: 8px;"
         alt="Aperçu">

    <div id="image-upload-status" class="mt-3"></div>
    <div id="category-images-gallery" class="row g-3 mt-2"></div>
</section>

@section Scripts {
    <script src="~/js/category-images.js" asp-append-version="true"></script>
}