@model FR_WS2_BaseLab.Models.Category

@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>
<p>@Model.Description</p>
<h2>Images de la catégorie</h2>

<div class="mb-4">
    <form id="uploadForm">
        @Html.AntiForgeryToken()
        <div class="input-group" style="max-width: 500px;">
            <input type="file" id="imageInput" class="form-control" accept="image/*" />
            <button type="button" class="btn btn-primary" onclick="uploadImage()">
                Téléverser
            </button>
        </div>
        <small class="text-muted">JPG, PNG, GIF ou WEBP — max 2 Mo</small>
        <div id="uploadMessage" class="mt-2"></div>
    </form>
</div>
 
@* Galerie d'images *@
<div id="gallery" class="d-flex flex-wrap gap-3">
    @foreach (var img in Model.CategoryImages)
    {
        <div class="card" style="width: 200px;" id="card-@img.Id">
            <img src="/uploads/categories/@Model.Id/@img.FileName"
                 class="card-img-top"
                 alt="@img.AltText"
                 style="height: 150px; object-fit: cover;" />
            <div class="card-body p-2">
                <small class="text-muted d-block text-truncate" title="@img.OriginalFileName">
                    @img.OriginalFileName
                </small>
                <button class="btn btn-danger btn-sm mt-1 w-100"
                        onclick="deleteImage(@img.Id)">
                    Supprimer
                </button>
            </div>
        </div>
    }
</div>
 
<hr />
<a asp-action="Index" class="btn btn-secondary mt-2">← Retour à la liste</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning mt-2">Modifier</a>
 
@section Scripts {
    <script>
        const categoryId = @Model.Id;
        const token = document.querySelector('[name="__RequestVerificationToken"]').value;
 
        async function uploadImage() {
            const input = document.getElementById('imageInput');
            const msgDiv = document.getElementById('uploadMessage');
 
            if (!input.files || input.files.length === 0) {
                showMessage('Veuillez sélectionner un fichier.', 'warning');
                return;
            }
 
            const formData = new FormData();
            formData.append('file', input.files[0]);
 
            showMessage('Téléversement en cours...', 'info');
 
            try {
                const response = await fetch(`/categories/${categoryId}/images/upload`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: formData
                });
 
                const result = await response.json();
 
                if (result.success) {
                    showMessage('Image téléversée avec succès!', 'success');
                    addImageToGallery(result.data);
                    input.value ='';
                } else {
                    showMessage(result.message || 'Erreur lors du téléversement.', 'danger');
                }
            } catch (err) {
                showMessage('Erreur réseau : ' + err.message, 'danger');
            }
        }
 
        function addImageToGallery(result) {
            const gallery = document.getElementById('gallery');
 
            const card = document.createElement('div');
            card.className = 'card';
            card.style.width = '200px';
            card.id = `card-${result.id}`;
 
            card.innerHTML = `
                <img src="${result.url}"
                     class="card-img-top"
                     style="height: 150px; object-fit: cover;"
                     alt="" />
                <div class="card-body p-2">
                    <small class="text-muted d-block text-truncate" title="${result.originalFileName}">
                        ${result.originalFileName}
                    </small>
                    <button class="btn btn-danger btn-sm mt-1 w-100"
                            onclick="deleteImage(${result.id})">
                        Supprimer
                    </button>
                </div>
            `;
 
            gallery.appendChild(card);
        }
 
        async function deleteImage(imageId) {
            if (!confirm('Supprimer cette image?')) return;
 
            const formData = new FormData();
            formData.append('id', imageId);
 
            const response = await fetch(`/categories/${categoryId}/images/${imageId}`, {
                method: 'DELETE',
                headers: { 'RequestVerificationToken': token }
            });
 
            const result = await response.json();
            if (result.success) {
                document.getElementById(`card-${imageId}`)?.remove();
            }
        }
 
        function showMessage(msg, type) {
            const div = document.getElementById('uploadMessage');
            div.innerHTML = `<div class="alert alert-${type} py-1 px-2">${msg}</div>`;
        }
    </script>
}
    